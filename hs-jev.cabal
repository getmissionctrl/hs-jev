cabal-version:      3.0
name:               hs-jev
version:            0.1.0.0
synopsis:           Haskell client for TypeSafe's System One (Jev) API
license:            MIT
build-type:         Simple

common warnings
  ghc-options: -Wall

common extensions
  default-extensions: OverloadedStrings
                    , ScopedTypeVariables
                    , LambdaCase
                    , DuplicateRecordFields
                    , OverloadedRecordDot
                    , RankNTypes

library
  import:           warnings, extensions
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:  Jev
                    Jev.Types
                    Jev.Ask
                    Jev.Client
                    Jev.Patterns
  build-depends:    base >=4.14 && <5
                  , aeson >=2.0
                  , bytestring
                  , text
                  , containers
                  , http-client
                  , http-client-tls
                  , http-types
                  , free
                  , transformers
                  , retry

executable hs-jev-examples
  import:           warnings, extensions
  hs-source-dirs:   example
  main-is:          Main.hs
  default-language: Haskell2010
  build-depends:    base, hs-jev, aeson, text, containers, optparse-applicative

test-suite spec
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  default-language: Haskell2010
  other-modules:    TestUtil
                    Jev.TypesSpec
                    Jev.AskSpec
                    Jev.ClientSpec
                    Jev.PatternsSpec
  build-depends:    base, hs-jev, aeson, text, bytestring, containers
                  , hspec, QuickCheck

test-suite live
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Live.hs
  default-language: Haskell2010
  build-depends:    base, hs-jev, aeson, text, containers
